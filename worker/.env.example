# --- Required -------------------------------------------------------------
# Supabase project settings -> API. The service role key is a secret: keep it on the worker only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb_secret-key

# --- RAG and explanations --------------------------------------------------
# With an OpenAI key, embeddings use text-embedding-3-small (384 dims) and explanations use OPENAI_CHAT_MODEL.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# openai | local | none   (default: openai when OPENAI_API_KEY is set, otherwise none)
EMBEDDING_PROVIDER=

# --- Optional ----------------------------------------------------------------
# Comma-separated origins allowed to call the worker API from the browser.
SM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SM_API_PORT=8787
SEMGREP_JOBS=2
SM_MAX_ARCHIVE_MB=50
SM_MAX_UNCOMPRESSED_MB=500

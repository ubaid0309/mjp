  PROJECTS {
    uuid id PK
    uuid owner_id FK
    text name
    jsonb scan_settings
  }
  SCAN_JOBS {
    uuid id PK
    uuid project_id FK
    text status
    text stage
    int batches_done
    int batches_total
    jsonb coverage
  }
  VULNERABILITIES {
    uuid id PK
    uuid project_id FK
    text fingerprint
    text severity
    text_array cwe_ids
    numeric risk_score
    text status
    text verification_status
  }
  KNOWLEDGE_DOCUMENTS {
    uuid id PK
    text cwe_id UK
    text category
    text_array remediation
    text index_status
  }
  KNOWLEDGE_CHUNKS {
    uuid id PK
    uuid document_id FK
    text section
    vector_384 embedding
    text embedding_model
  }
  FINDING_KNOWLEDGE_REFS {
    uuid vulnerability_id FK
    uuid document_id FK
    real similarity
    text match_type
  }

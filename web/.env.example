# Supabase project settings -> API. The anon/publishable key is safe to ship to the browser (RLS protects data).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Where the SecureMatrix worker API runs (docker compose exposes 8787).
VITE_WORKER_API_URL=http://localhost:8787
